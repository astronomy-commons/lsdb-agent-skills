# Example site file. Copy it to <name>.local.env next to this file (ignored by git), fill in your values, and point
# HATS_PUBLISH_SITE_ENV at it. Every variable is described in CONFIG.md. Lines use the form
# export VAR="${VAR:-default}" so that a value already exported in the shell wins over the file.
# Do not commit a filled-in copy: hosts, paths, groups and batch accounts are site-specific and stay out of this
# public repository.

# Web host: catalogs are stored on a data-transfer host and served by a web host that mounts the same store.
export HATS_PUBLISH_WEB_URL="${HATS_PUBLISH_WEB_URL:-https://<web host>/<catalog path>}"
export HATS_PUBLISH_WEB_DATA_HOST="${HATS_PUBLISH_WEB_DATA_HOST:-<ssh host that writes the data store>}"
export HATS_PUBLISH_WEB_DATA_ROOT="${HATS_PUBLISH_WEB_DATA_ROOT:-/path/to/catalog/store}"
export HATS_PUBLISH_WEB_HOST="${HATS_PUBLISH_WEB_HOST:-<ssh host that serves the web tree>}"
export HATS_PUBLISH_WEB_DATA_ROOT_ON_WEB="${HATS_PUBLISH_WEB_DATA_ROOT_ON_WEB:-/path/to/catalog/store/as/seen/from/web/host}"
# the directory that holds the per-catalog symlinks and the .htaccess with the autoindex descriptions
export HATS_PUBLISH_WEB_ROOT="${HATS_PUBLISH_WEB_ROOT:-/path/to/web/root}"
export HATS_PUBLISH_WEB_USER="${HATS_PUBLISH_WEB_USER:-$USER}"
export HATS_PUBLISH_WEB_GROUP="${HATS_PUBLISH_WEB_GROUP:-<unix group of the catalog store>}"

# Mirror: a shared tree on a compute site, optionally served over HTTP.
export HATS_PUBLISH_MIRROR_ROOT="${HATS_PUBLISH_MIRROR_ROOT:-/path/to/mirror/root}"
export HATS_PUBLISH_MIRROR_URL="${HATS_PUBLISH_MIRROR_URL:-}"            # empty = the mirror is not served
export HATS_PUBLISH_MIRROR_GROUP="${HATS_PUBLISH_MIRROR_GROUP:-<unix group of the mirror tree>}"
# key under which the mirror URL is listed in the site page's catalog.json
export HATS_PUBLISH_MIRROR_URL_KEY="${HATS_PUBLISH_MIRROR_URL_KEY:-mirror_catalog}"

# Batch jobs: the sbatch options that select the account, partition and QOS for job.sbatch.
# On a preemptable QOS that cancels instead of requeueing, run resubmit_loop.sh next to the job.
export HATS_PUBLISH_SBATCH_OPTS="${HATS_PUBLISH_SBATCH_OPTS:---account=<account> --partition=<partition> --qos=<qos>}"

# Shared interactive nodes: caps that keep an import within what the site allows on a login or dev node.
# Leave empty for no cap. A batch job on a dedicated node clears them itself.
export HATS_PUBLISH_MAX_CPUS="${HATS_PUBLISH_MAX_CPUS:-}"
export HATS_PUBLISH_MAX_MEM_GB="${HATS_PUBLISH_MAX_MEM_GB:-}"
